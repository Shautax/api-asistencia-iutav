PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asistencia_db
# En Railway no hace falta definir DB_*: si faltan se usan MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD y MYSQLDATABASE del servicio MySQL (ver DEPLOY_RAILWAY.md).
# Zona horaria de la sesión MySQL. Necesaria en servidores en UTC (Railway): -04:00 = Venezuela
# DB_TIMEZONE=-04:00

JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=8h

# La geocerca de la sede (latitud, longitud y radio_permitido en metros) se guarda en la tabla
# configuracion_red (PUT /api/configuracion/red, solo coordinador_master).

# Solo si la API corre detrás de un proxy/balanceador (ej: 1 = un salto, o loopback). En Railway: 1
# TRUST_PROXY=1

# Código de instalación: solo sirve para crear el PRIMER coordinador_master (POST /api/auth/registro).
# Cuando ya existe un master el sistema queda sellado y este código se ignora.
MASTER_INVITE_CODE=cambia_este_codigo

# Opcional: dominios del panel web que pueden llamar a la API (CORS), separados por coma
# CORS_ORIGIN=https://dashboard-asistencia-iutav.netlify.app
